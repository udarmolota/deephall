<?xml version="1.0" encoding="utf-8"?>
<!-- The debug build is the Deephall launcher and installs next to Zomdroid, so it uses the
     game's own dwarf icon instead of Zomdroid's. The bitmap fills the whole 108dp layer with the
     dwarf inside the 72dp visible area, so the launcher mask never shows its edges. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_deephall"/>
    <foreground android:drawable="@android:color/transparent"/>
</adaptive-icon>
