<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press menu of the Deephall icon: the hidden launcher's settings, the controls
     editor, the saves (export and import share one shortcut: launchers show about four) and the
     bug report.
     targetPackage is the debug application id (com.zomdroid + ".deephall"); resources cannot read
     it from the build, so this file lives in the debug source set, and the release build has its
     own copy in src/release/ with the release application id. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@drawable/shortcut_settings"
        android:shortcutShortLabel="@string/shortcut_settings_short"
        android:shortcutLongLabel="@string/shortcut_settings_long">
        <intent
            android:action="com.zomdroid.action.OPEN_SETTINGS"
            android:targetPackage="com.zomdroid.deephall"
            android:targetClass="com.zomdroid.LauncherActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="controls"
        android:enabled="true"
        android:icon="@drawable/shortcut_controls"
        android:shortcutShortLabel="@string/shortcut_controls_short"
        android:shortcutLongLabel="@string/shortcut_controls_long">
        <intent
            android:action="com.zomdroid.action.EDIT_CONTROLS"
            android:targetPackage="com.zomdroid.deephall"
            android:targetClass="com.zomdroid.ControlsEditorActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="saves"
        android:enabled="true"
        android:icon="@drawable/shortcut_saves"
        android:shortcutShortLabel="@string/shortcut_saves_short"
        android:shortcutLongLabel="@string/shortcut_saves_long">
        <intent
            android:action="com.zomdroid.action.SAVES"
            android:targetPackage="com.zomdroid.deephall"
            android:targetClass="com.zomdroid.SaveTransferActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="bug_report"
        android:enabled="true"
        android:icon="@drawable/shortcut_bug_report"
        android:shortcutShortLabel="@string/shortcut_bug_report_short"
        android:shortcutLongLabel="@string/shortcut_bug_report_long">
        <intent
            android:action="com.zomdroid.action.SEND_BUG_REPORT"
            android:targetPackage="com.zomdroid.deephall"
            android:targetClass="com.zomdroid.LauncherActivity" />
    </shortcut>
</shortcuts>
