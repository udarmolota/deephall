<?xml version="1.0" encoding="utf-8"?>
<!-- The debug and release builds are the standalone Deephall app (both use this src/deephall/
     folder, see app/build.gradle.kts): the icon starts the game, and the launcher
     stays in the app without an icon of its own, reachable from the start screen's error button
     and from the icon's shortcuts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The daily update check runs only when there is a network (UpdateChecker); Android requires this
         for such a job. A normal permission: granted at install, the player is never asked. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <activity android:name=".LauncherActivity">
            <intent-filter tools:node="removeAll" />
        </activity>
        <activity
            android:name=".DeephallStartActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- The daily check for a new Deephall release, see UpdateChecker -->
        <service
            android:name=".UpdateCheckJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
