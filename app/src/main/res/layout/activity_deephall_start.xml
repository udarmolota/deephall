<?xml version="1.0" encoding="utf-8"?>
<!-- The standalone Deephall app's start screen: one line, one bar, and on failure the error with
     a way into the launcher for logs and a bug report. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/start_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/deephall_preparing"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:id="@+id/start_message_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:visibility="gone"
        tools:text="Extracting…"
        tools:visibility="visible" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/start_progress_lpi"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:indeterminate="true" />

    <ScrollView
        android:id="@+id/start_error_sv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/start_error_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            tools:text="java.io.IOException: No space left on device" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_open_launcher_mb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/deephall_open_launcher"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
